# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this app, used for email confirmation and password-reset links.
# Locally use http://localhost:5173; on Vercel use the deployed https URL.
VITE_APP_URL=http://localhost:5173

# Only VITE_* values belong in the browser. API keys (ElevenLabs, Base44,
# Resend, service role) are Supabase secrets and must never be added here.
# Do not use VITE_RESEND_API_KEY / VITE_RESEND_FROM_EMAIL: Edge Functions read
# RESEND_API_KEY and RESEND_FROM from `supabase secrets set` instead.
